{
  "expo": {
    "name": "Event Horizon",
    "slug": "event-horizon",
    "scheme": "ehdemo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.example.eventhorizon",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#080c18",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.eventhorizon.app"
    },
    "web": {
      "backgroundColor": "#000000"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": "production",
          "default": false
        }
      }
    },
    "experiments": {
      "baseUrl": "/eh-demo"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-secure-store",
      "expo-splash-screen"
    ],
    "owner": "777777jjjwwfgc"
  }
}
